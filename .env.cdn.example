CDN_ENDPOINT=https://kr.object.ncloudstorage.com
CDN_REGION=kr-standard
CDN_BUCKET=
CDN_PUBLIC_BASE_URL=https://rid.gcdn.ntruss.com
CDN_PREFIX=zep-script/seoul_2/npc
CDN_CACHE_CONTROL=public, max-age=31536000, immutable
CDN_ACL=

# Use either CDN_* or NCP_* credential names.
CDN_ACCESS_KEY_ID=
CDN_SECRET_ACCESS_KEY=

# Alternative names also supported by scripts/upload-cdn-asset.js:
# NCP_ACCESS_KEY_ID=
# NCP_SECRET_ACCESS_KEY=
