{
  "name": "history_josun",
  "version": "0.16.2",
  "scripts": {
    "build": "node scripts/build-museum-widget.cjs && zep-script build",
    "pack": "npm run build && npm run archive",
    "archive": "node scripts/archive-museum.cjs",
    "publish:zep": "node scripts/check-museum-deploy.cjs && zep-script publish",
    "test:npc": "node scripts/build-museum-widget.cjs && node --test src/__tests__/nationalMuseumDialogues.test.cjs",
    "deploy": "npm run test:npc && npm run build && npm run archive && npm run publish:zep",
    "cdn:upload": "node scripts/upload-cdn-asset.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.18.6",
    "@babel/core": "^7.18.6",
    "@babel/preset-typescript": "^7.18.6",
    "@types/node": "^22.13.1",
    "babel-loader": "^10.0.0",
    "eslint": "^8.10.0",
    "ts-loader": "^9.5.2",
    "typescript": "^4.7.4",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "zep-script": "0.16.2"
  }
}
